# Copia este archivo como .env y cambia los valores. NUNCA subas .env a GitHub.

# En tu PC: 127.0.0.1   |   En AWS: la IP PRIVADA del Backend (ej. 10.1.0.15)
HOST=127.0.0.1
PORT=3000

# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_de_al_menos_32_caracteres

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=pon_aqui_la_contraseña_de_postgres
DB_NAME=consultorio_db

# true solo mientras creas los usuarios; después ponlo en false (mínimo privilegio)
REGISTRO_ABIERTO=true
